# โฟลเดอร์แพ็กเกจ Node.js (Dependencies)
node_modules/

# โฟลเดอร์ผลผลิตจากการบิวด์ (จะถูกนำไป Deploy ผ่านสคริปต์ gh-pages แยกต่างหาก)
dist/

# ไฟล์ล็อกและประวัติข้อผิดพลาดของระบบแพ็กเกจ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ตัวแปรสภาพแวดล้อมและความลับเฉพาะเครื่อง
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# ไฟล์ระบบของ OS
.DS_Store
Thumbs.db
Desktop.ini

# ไฟล์ประมวลผล Python (ระบบเดิม)
__pycache__/
*.py[cod]

# โฟลเดอร์เฉพาะของ IDE หรือโปรแกรมเขียนโค้ด
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
